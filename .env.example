# Pepperstone / cTrader FIX (demo defaults from your portal)
# Copy to .env and set FIX_PASSWORD to your trading account password.

FIX_HOST=demo-us-eqx-01.p.c-trader.com
FIX_QUOTE_PORT=5211
FIX_TRADE_PORT=5212
FIX_USE_SSL=true

FIX_SENDER_COMP_ID=demo.pepperstone.5294375
FIX_TARGET_COMP_ID=cServer
FIX_ACCOUNT=5294375
FIX_PASSWORD=your_trading_password_here

FIX_SENDER_SUB_ID=5294375

# Position sizing — always in USD
FIX_BALANCE_USD=200

# ── cTrader Open API (live balance + trade history) ───────────────────────────
# cTrader Open API provides live balance (fixes position sizing) and deal
# history that the FIX protocol cannot supply. Leave all 4 unset to fall back
# to FIX_BALANCE_USD for position sizing with no deal history.
#
# Credentials from cTrader SPACE → your app → API Access.
# OPEN_API_CTID_TRADER_ACCOUNT_ID is your numeric account ID (same as FIX_ACCOUNT).
OPEN_API_CLIENT_ID=your_client_id_here
OPEN_API_CLIENT_SECRET=your_client_secret_here
# OPEN_API_REFRESH_TOKEN — optional; set after running `python -m broker.open_api_auth`:
#   the auth flow generates one automatically and saves it to secrets/open_api_token.json.
#   Only set this if you already have a refresh token and want to skip the auth flow.
#   The OAuth flow is preferred since it handles the full token lifecycle.
# OPEN_API_REFRESH_TOKEN=your_refresh_token_here

OPEN_API_CTID_TRADER_ACCOUNT_ID=5294375

# ── Firebase Firestore (optional — for Cloudways / remote monitoring) ─────────
# Use Admin SDK service account JSON, NOT the web apiKey config.
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=./secrets/my-bots-7bd9a-firebase-adminsdk.json
FIREBASE_BOT_ID=forex-xgb
FIREBASE_ACCOUNT_ID=5294375
FIREBASE_HEARTBEAT_SEC=300
# Log lines (INFO+) batched to bots/{bot_id}/daily_logs/{YYYY-MM-DD}/entries/
FIREBASE_LOG_LEVEL=INFO
